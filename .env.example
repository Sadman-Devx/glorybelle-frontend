# GLORYBELLE storefront — copy to .env.local and fill in.
# NEXT_PUBLIC_* values are BAKED INTO THE BUNDLE AT BUILD TIME:
# change one, then rebuild (`npm run build`) — restarting is not enough.

# Base URL of the Django API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe PUBLISHABLE key (pk_test_... / pk_live_...). Never put the secret key here.
# If this is missing the checkout shows "Il pagamento online non è disponibile".
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL — used for sitemap, robots and Open Graph (defaults to https://glorybelle.it)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown on the site (defaults to info@glorybelle.it)
NEXT_PUBLIC_CONTACT_EMAIL=info@glorybelle.it

# Optional analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Server-only (NOT exposed to the browser) — admin panel proxy ----
# 32-byte hex secret that seals the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# API URL used by the Next server itself (e.g. http://backend:8000 inside Docker).
# Falls back to NEXT_PUBLIC_API_URL when empty.
ADMIN_API_INTERNAL_URL=
